{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melatonyne",
  "version": "1.1.0",
  "identifier": "com.melatonyne.app",
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
